# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER commit these!
# They contain sensitive keys like SUPABASE_SERVICE_ROLE_KEY
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test
# Allow example files to be committed (they don't contain real keys)
!.env.example
!.env.local.example

# vercel
.vercel

# opennext / cloudflare
.open-next
.worker-next

# typescript
*.tsbuildinfo
next-env.d.ts
